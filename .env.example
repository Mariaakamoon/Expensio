
# Copy this file to .env and fill in your local settings.
# Never commit real passwords or credentials.

DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
FLASK_DEBUG=0

# Amazon S3 receipt storage
AWS_REGION=ap-south-1
S3_RECEIPTS_BUCKET=expensio-receipts-mumbai-2026-mj01
